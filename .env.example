# --- Binary Group API ---
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://binary:binary_dev_password@localhost:5433/binary_group
# Long random string (openssl rand -base64 48)
JWT_SECRET=change-me
# Origins allowed to call the API from the browser (comma separated)
CORS_ORIGINS=http://localhost:3000
# Next.js on-demand revalidation (must match REVALIDATE_SECRET in web/.env.local)
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=change-me
# First admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@binarygroup.dev
ADMIN_PASSWORD=change-me
ADMIN_NAME=ئاراس محەمەد
